<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center"
    android:background="#FFFFFF">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🚀 Fast GitHub" android:textSize="32sp" android:textStyle="bold"
        android:textColor="#FF5722" android:layout_marginBottom="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="开启后，本机所有 App 访问 GitHub 系列域名将使用本地优化 IP 解析，提升访问速度并避免 DNS 污染。"
        android:textSize="14sp" android:textColor="#666666" android:gravity="center"
        android:layout_marginBottom="32dp"/>
    <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="○ 未开启" android:textSize="18sp"
        android:textColor="#999999" android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/btnToggle" android:layout_width="200dp" android:layout_height="56dp"
        android:text="开启 VPN" android:textSize="18sp" android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Hosts 数据来源: GitHub520" android:textSize="12sp"
        android:textColor="#AAAAAA" android:gravity="center" android:layout_marginTop="40dp"/>
</LinearLayout>
